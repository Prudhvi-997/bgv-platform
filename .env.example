# KCheck BGV Platform — Environment variables
# Copy to .env and fill in actual values. Never commit .env.

# Django
DJANGO_SETTINGS_MODULE=config.dev
SECRET_KEY=replace-me-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Operational DB (MySQL)
OPERATIONAL_DB_NAME=kcheck_operational
OPERATIONAL_DB_USER=kcheck
OPERATIONAL_DB_PASSWORD=change-me
OPERATIONAL_DB_HOST=127.0.0.1
OPERATIONAL_DB_PORT=3306

# Reporting DB (MySQL — SEPARATE INSTANCE per CLAUDE.md Part 4.8)
# Reporting app reads from this DB only; never queries operational DB.
REPORTING_DB_NAME=kcheck_reporting
REPORTING_DB_USER=kcheck_reporting_ro
REPORTING_DB_PASSWORD=change-me
REPORTING_DB_HOST=127.0.0.1
REPORTING_DB_PORT=3307

# Redis (Celery broker + result backend)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Object storage (evidence store)
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_STORAGE_PATH=/var/kcheck/evidence

# Notifications
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=

# Document conversion (LibreOffice headless)
LIBREOFFICE_BIN=/usr/bin/soffice

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS / origins (per-portal)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
